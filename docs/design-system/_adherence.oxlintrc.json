        "selector": "JSXOpeningElement[name.name='ModuleCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|note|style|key|ref|className|style|children)$/]",
        "message": "<ModuleCell> doesn't accept that prop. Declared props: title, description, note, style."
      },
