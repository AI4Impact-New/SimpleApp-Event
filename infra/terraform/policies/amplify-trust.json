{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "amplify.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "767491588787"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:amplify:ap-south-1:767491588787:apps/*"
        }
      }
    }
  ]
}