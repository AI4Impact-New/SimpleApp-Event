# Copy to terraform.tfvars and replace the password before planning.
# terraform.tfvars is ignored by Git.
aws_profile            = "jm"
aws_region             = "ap-south-1"
environment            = "production"
project_name           = "pilearn"
db_instance_class      = "db.t4g.micro"
db_allocated_storage   = 20
db_name                = "PiLearn"
db_username            = "PiLearnAdmin"
cognito_pool_name      = "pilearn-users"
cognito_client_name    = "pilearn-app"
materials_bucket_name  = "pilearn-materials-767491588787"
lambda_memory_size     = 512
vpc_id                 = "vpc-0d810a9529b474625"
vpc_cidr               = "172.31.0.0/16"
db_publicly_accessible = false
db_password = "REPLACE_WITH_A_RANDOM_PASSWORD"
